# ==============================================================================
# AMARU INMUEBLES - Variables de Entorno de Configuración
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (Local o Supabase)
# ------------------------------------------------------------------------------
# Local:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amaru_inmuebles?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/amaru_inmuebles?schema=public"
#
# Supabase + Vercel:
#   DATABASE_URL -> Transaction pooler (puerto 6543 + ?pgbouncer=true) para runtime serverless
#   DIRECT_URL   -> Session pooler (puerto 5432 en *.pooler.supabase.com) para migraciones Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amaru_inmuebles?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/amaru_inmuebles?schema=public"

# Configuración de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="Amaru Inmuebles"
NEXT_PUBLIC_COMPANY_TAGLINE="Gestión Inmobiliaria & Corretaje de Alto Estándar"
NEXT_PUBLIC_CONTACT_EMAIL="contacto@amaruinmuebles.cl"
NEXT_PUBLIC_CONTACT_PHONE="+56 9 8765 4321"
NEXT_PUBLIC_CONTACT_WHATSAPP="56987654321"
NEXT_PUBLIC_OFFICE_ADDRESS="Av. Alonso de Córdova 3788, Oficina 702, Vitacura, Santiago"
