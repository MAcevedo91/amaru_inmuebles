# Cadena de conexión a base de datos PostgreSQL (Local, Vercel Prisma Postgres o Supabase)
# Formato: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[nombre_base_datos]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amaru_inmuebles?schema=public"

# Configuración de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
